# intermediate_code.py
import re
import csv
from models import Triplo
from constants import RE_IDENTIFICADOR, RE_ENTERO, RE_DECIMAL, RE_CADENA

class IntermediateCodeGenerator:
    def __init__(self):
        self.index = 1

    def reset(self):
        self.index = 1

    def generar_desde_fuente(self, source: str):
        """
        Genera triplos (intermedio) a partir del código fuente.
        Soporta asignaciones y bucles for ... in range(...).
        """
        self.reset()
        triplos = []
        lines = [line.strip() for line in source.splitlines() if line.strip()]

        i = 0
        while i < len(lines):
            line = lines[i]

            # ----- For tipo: for mnmX in range(0,10): -----
            if line.startswith("for ") and "in range" in line:
                triplos.extend(self._emitir_for(line))
                i += 1
                continue

            # ----- Asignación tipo: mnmVar = 2 + 3; -----
            if "=" in line and not line.startswith("\\"):
                triplos.extend(self._emitir_asignacion(line))
                i += 1
                continue

            i += 1

        return triplos

    # ================================================
    # GENERADORES DE TRIPLOS
    # ================================================
    def _emitir_asignacion(self, linea):
        """
        Procesa expresiones tipo:
        mnmA = 2 + 2.5;
        mnmB = mnmA * 3;
        """
        triplos = []

        # Limpiar ';' final si existe
        linea = linea.rstrip(';')
        if '=' not in linea:
            return triplos

        lhs, rhs = map(str.strip, linea.split('=', 1))
        tokens = re.findall(r'mnm\w+|\d+\.\d+|\d+|[+\-*/]', rhs)

        # Caso simple: asignación directa
        if len(tokens) == 1:
            triplos.append(Triplo(self._next(), lhs, tokens[0], '='))
            return triplos

        # Caso compuesto: genera temporales
        temp = "T1"
        triplos.append(Triplo(self._next(), temp, tokens[0], '='))
        i = 1
        while i < len(tokens):
            if tokens[i] in ['+', '-', '*', '/'] and i+1 < len(tokens):
                triplos.append(Triplo(self._next(), temp, tokens[i+1], tokens[i]))
                i += 2
            else:
                i += 1
        triplos.append(Triplo(self._next(), lhs, temp, '='))
        return triplos

    def _emitir_for(self, linea):
        """
        for mnmX in range(0, 3):
        """
        triplos = []
        patron = r'for\s+(mnm\w+)\s+in\s+range\s*\(([^)]*)\):'
        m = re.match(patron, linea)
        if not m:
            return triplos

        var, rango = m.groups()
        valores = [v.strip() for v in rango.split(',')]

        if len(valores) == 1:
            start, end = '0', valores[0]
        else:
            start, end = valores[0], valores[1]

        # i = start
        triplos.append(Triplo(self._next(), var, start, '='))

        # condición i < end
        triplos.append(Triplo(self._next(), var, end, '<'))

        # cuerpo genérico (placeholder)
        triplos.append(Triplo(self._next(), 'TR1', 'TRUE', '→ cuerpo'))

        # incremento i = i + 1
        triplos.append(Triplo(self._next(), var, '1', '+'))

        # salto al inicio
        triplos.append(Triplo(self._next(), '', 'inicio_for', 'JMP'))

        return triplos

    def guardar_csv(self, triplos, path="Triplo.csv"):
        with open(path, "w", newline="") as f:
            writer = csv.writer(f)
            writer.writerow(["Índice", "Dato Objeto", "Dato Fuente", "Operador"])
            for t in triplos:
                writer.writerow([t.idx, t.dato_objeto, t.dato_fuente, t.operador])

    def _next(self):
        i = self.index
        self.index += 1
        return i
